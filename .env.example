# =========================================
# HealthRisk AI — Environment Configuration
# =========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# --- Database ---
POSTGRES_USER=healthrisk
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=healthrisk_db

# --- Backend ---
# CRITICAL: Change this to a random 32+ char string
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

DATABASE_URL=postgresql+asyncpg://healthrisk:change_this_password@postgres:5432/healthrisk_db
# Local dev (no Docker): replace 'postgres' with 'localhost'

DEBUG=false
LOG_LEVEL=INFO

ACCESS_TOKEN_EXPIRE_MINUTES=60

MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

CORS_ORIGINS=http://localhost:3000,http://frontend:80

# --- Analysis Thresholds ---
MIN_HISTORY_COUNT=3
BASELINE_Z_THRESHOLD_MINOR=1.0
BASELINE_Z_THRESHOLD_MODERATE=2.0
BASELINE_Z_THRESHOLD_SIGNIFICANT=3.0

CONSISTENCY_W1=0.4
CONSISTENCY_W2=0.4
CONSISTENCY_W3=0.2

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
